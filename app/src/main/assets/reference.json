        },
        {
          "term": "Courant et charge",
          "description": "I = Q/t"
        },
        {
          "term": "Résistances en série",
          "description": "Rtot = R1 + R2 + …"
        },
        {
          "term": "Résistances en parallèle",
          "description": "1/Rtot = 1/R1 + 1/R2 + …"
        },
        {
          "term": "Deux résistances parallèles",
          "description": "Rtot = R1R2/(R1 + R2)"
        },
        {
          "term": "Diviseur non chargé",
          "description": "Us = Ue × R2/(R1 + R2)",
          "extra": "Sortie prise aux bornes de R2."
        },
        {
          "term": "Condensateurs en parallèle",
          "description": "Ctot = C1 + C2 + …"
        },
        {
          "term": "Condensateurs en série",
          "description": "1/Ctot = 1/C1 + 1/C2 + …"
        },
        {
          "term": "Inductances série non couplées",
          "description": "Ltot = L1 + L2 + …"
        },
        {
          "term": "Réactance inductive",
          "description": "XL = 2πfL"
        },
        {
          "term": "Réactance capacitive",
          "description": "XC = 1/(2πfC)"
        },
        {
          "term": "Impédance RLC série",
          "description": "|Z| = √(R² + (XL − XC)²)"
        },
        {
          "term": "Résonance LC",
          "description": "f0 = 1/(2π√(LC))"
        },
        {
          "term": "Constante de temps RC",
          "description": "τ = R × C"
        },
        {
          "term": "Période et fréquence",
          "description": "T = 1/f"
        },
        {
          "term": "Sinusoïde",
