<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_goal_background">
    <TextView android:id="@id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_preview_goal_title" android:textSize="11sp" android:textStyle="bold" android:textColor="#087F82" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@id/widget_metric" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_goal_metric" android:textSize="25sp" android:textStyle="bold" android:textColor="#073D40" android:maxLines="1" android:ellipsize="end"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_goal_status" android:textSize="12sp" android:textColor="#45676A" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_mascot" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="3dp"
        android:scaleType="fitCenter" android:importantForAccessibility="yes" android:contentDescription="@string/widget_preview_week_chart" />
    <ProgressBar android:id="@id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
        android:progressTint="#087F82" android:progressBackgroundTint="#FFFFFF" android:max="100" android:progress="40" />
    <TextView android:id="@id/widget_review" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="@string/widget_review" android:textSize="12sp" android:textStyle="bold" android:textColor="#087F82" />
</LinearLayout>
