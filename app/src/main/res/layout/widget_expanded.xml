<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_streak_background" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:text="@string/widget_preview_streak_title" android:textSize="12sp" android:textColor="#45676A" android:autoSizeMinTextSize="9sp" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
<TextView android:id="@+id/widget_badge" android:layout_width="wrap_content" android:layout_height="22dp" android:text="@string/widget_preview_badge" android:textSize="11sp" android:textColor="#45676A" android:autoSizeMinTextSize="9sp" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:background="@drawable/widget_chip_background" android:paddingHorizontal="8dp" android:visibility="gone" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/widget_metric" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="@string/widget_preview_streak_metric" android:textSize="32sp" android:textStyle="bold" android:textColor="#073D40" android:autoSizeMinTextSize="11sp" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"  />
<ImageView android:id="@+id/widget_mascot" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" android:visibility="gone" />
</LinearLayout>
<ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="4dp" android:src="@drawable/widget_streak_days" android:scaleType="fitXY" android:importantForAccessibility="yes" android:contentDescription="@string/widget_preview_week_chart" />
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="20dp" android:text="@string/widget_preview_streak_status" android:textSize="13sp" android:textColor="#45676A" android:autoSizeMinTextSize="9sp" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:visibility="gone" />
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressDrawable="@drawable/widget_progress_track" android:max="100" android:progress="40" android:visibility="gone" />
<TextView android:id="@+id/widget_review" android:layout_width="wrap_content" android:layout_height="24dp" android:text="@string/widget_review" android:textSize="12sp" android:textColor="#45676A" android:autoSizeMinTextSize="9sp" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:paddingHorizontal="12dp" android:background="@drawable/widget_chip_background" android:textStyle="bold" />
</LinearLayout>
